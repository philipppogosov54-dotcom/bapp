# ==============================================================================
# BeautyScore API - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Frontend URL (for CORS and redirects)
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://beautyscore:beautyscore_dev_password@localhost:5433/beautyscore?schema=public"

# ------------------------------------------------------------------------------
# Redis (Sessions & Caching)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# Cache TTL settings (in seconds)
CACHE_TTL_DEFAULT=3600
CACHE_TTL_LLM=86400
CACHE_TTL_PRODUCTS=7200

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
# IMPORTANT: Generate secure secrets for production!
# Use: openssl rand -base64 64

# Access token (short-lived, 15 min)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Refresh token (long-lived, 7 days)
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Token expiration (seconds)
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# ------------------------------------------------------------------------------
# OAuth Providers
# ------------------------------------------------------------------------------

# Yandex ID (https://oauth.yandex.ru/)
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
YANDEX_CALLBACK_URL=http://localhost:3001/api/auth/yandex/callback

# VK ID (https://id.vk.com/business/go)
VK_APP_ID=your-vk-app-id
VK_APP_SECRET=your-vk-app-secret
VK_CALLBACK_URL=http://localhost:3001/api/auth/vk/callback

# Telegram Login Widget (https://core.telegram.org/widgets/login)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=YourBotUsername

# ------------------------------------------------------------------------------
# LLM Providers
# ------------------------------------------------------------------------------

# GigaChat (Sber) - https://developers.sber.ru/portal/products/gigachat
# API Key format: base64 encoded "client_id:client_secret"
GIGACHAT_API_KEY=your-gigachat-api-key-base64

# YandexGPT - https://cloud.yandex.ru/services/yandexgpt
YANDEX_GPT_API_KEY=your-yandex-gpt-api-key
YANDEX_GPT_FOLDER_ID=your-yandex-cloud-folder-id

# LLM Settings
LLM_PRIMARY_PROVIDER=gigachat
LLM_FALLBACK_PROVIDER=yandexgpt
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=1

# ------------------------------------------------------------------------------
# Email Service (SendPulse)
# ------------------------------------------------------------------------------
SENDPULSE_ID=your-sendpulse-id
SENDPULSE_SECRET=your-sendpulse-secret
EMAIL_FROM=noreply@beautyscore.ru
EMAIL_FROM_NAME=BeautyScore

# ------------------------------------------------------------------------------
# Analytics & Monitoring
# ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
FEATURE_OAUTH_ENABLED=true
FEATURE_SMS_VERIFICATION=false
FEATURE_LLM_RECOMMENDATIONS=true
FEATURE_PUSH_NOTIFICATIONS=false
